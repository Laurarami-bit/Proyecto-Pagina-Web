<%- include('../partials/header', { title }) %>

<h1>Productos</h1>

<% if (!products.length) { %>
  <p>Todavía no hay productos.</p>
<% } else { %>
  <table>
    <tr>
      <th>Imagen</th>
      <th>Nombre</th>
      <th>Categoría</th>
      <th>Precio</th>
      <th></th>
    </tr>
    <% products.forEach(function (p) { %>
      <tr>
        <td><img src="<%= p.image %>" alt=""></td>
        <td><%= p.name %></td>
        <td><%= p.category %></td>
        <td>$ <%= p.price %></td>
        <td><a href="/admin/productos/<%= p.id %>/editar">Editar</a></td>
      </tr>
    <% }) %>
  </table>
<% } %>

<%- include('../partials/footer') %>
