<%- include('../partials/head-publico', { title: 'Mi perfil' }) %>

<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/perfil.css">

<%- include('../partials/header-publico') %>

<main class="perfil-card">
    <img src="/images/users/<%= user.avatar || 'default.png' %>" alt="Foto de perfil">

    <h1><%= user.firstName %> <%= user.lastName %></h1>
    <p><strong>Correo:</strong> <%= user.email %></p>
    <p><strong>Categoría:</strong> <%= user.category %></p>
</main>

<%- include('../partials/footer') %>