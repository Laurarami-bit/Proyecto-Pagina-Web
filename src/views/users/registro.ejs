<%- include('../partials/head-publico', { title: 'Registro' }) %>

<% const e = typeof errors !== 'undefined' ? errors : {}; %>
<% const o = typeof old !== 'undefined' ? old : {}; %>

<link rel="stylesheet" href="/css/registro.css">

<div class="registro-container">

    <span class="icono-registro">👤</span>

    <img
        src="/images/logo.png"
        alt="Angelitos con amor"
        class="logo"
    >

    <div class="encabezado">
        <h1>REGISTRO</h1>
        <p>CREA TU CUENTA</p>
    </div>

    <form action="/usuarios/registro" method="POST" enctype="multipart/form-data" novalidate>

        <div class="campo">
            <label for="firstName">👤 NOMBRE</label>
            <input
                type="text"
                id="firstName"
                name="firstName"
                placeholder="INGRESA TU NOMBRE"
                value="<%= o.firstName || '' %>"
            >
            <% if (e.firstName) { %><span class="error"><%= e.firstName.msg %></span><% } %>
        </div>

        <div class="campo">
            <label for="lastName">👤 APELLIDO</label>
            <input
                type="text"
                id="lastName"
                name="lastName"
                placeholder="INGRESA TU APELLIDO"
                value="<%= o.lastName || '' %>"
            >
            <% if (e.lastName) { %><span class="error"><%= e.lastName.msg %></span><% } %>
        </div>

        <div class="campo">
            <label for="category">👤 CATEGORÍA</label>
            <select id="category" name="category">
                <option value="">SELECCIONA UNA CATEGORÍA</option>
                <option value="Cliente" <%= o.category === 'Cliente' ? 'selected' : '' %>>CLIENTE</option>
                <option value="Administrador" <%= o.category === 'Administrador' ? 'selected' : '' %>>TRABAJADOR</option>
            </select>
            <% if (e.category) { %><span class="error"><%= e.category.msg %></span><% } %>
        </div>

        <div class="campo ancho">
            <label for="email">✉️ CORREO ELECTRÓNICO</label>
            <input
                type="email"
                id="email"
                name="email"
                placeholder="laura@correo.com"
                value="<%= o.email || '' %>"
            >
            <% if (e.email) { %><span class="error"><%= e.email.msg %></span><% } %>
        </div>

        <div class="campo">
            <label for="password">🔒 CREA TU CONTRASEÑA</label>
            <input
                type="password"
                id="password"
                name="password"
                placeholder="CREA TU CONTRASEÑA"
            >
            <% if (e.password) { %><span class="error"><%= e.password.msg %></span><% } %>
        </div>

        <div class="campo">
            <label for="contrasenacon">🔒 CONFIRMA TU CONTRASEÑA</label>
            <input
                type="password"
                id="contrasenacon"
                name="contrasenacon"
                placeholder="CONFIRMA TU CONTRASEÑA"
            >
            <% if (e.contrasenacon) { %><span class="error"><%= e.contrasenacon.msg %></span><% } %>
        </div>

        <div class="terminos">
            <label for="terminos">
                ACEPTO LOS TÉRMINOS Y CONDICIONES
                Y POLÍTICAS DE PRIVACIDAD
            </label>

            <input
                type="checkbox"
                id="terminos"
                name="terminos"
            >
            <% if (e.terminos) { %><span class="error"><%= e.terminos.msg %></span><% } %>
        </div>

        <div class="campo">
            <label for="avatar">📷 IMAGEN DE PERFIL</label>
            <input
                type="file"
                id="avatar"
                name="avatar"
                accept=".jpg,.jpeg,.png,.gif"
            >
            <% if (e.avatar) { %><span class="error"><%= e.avatar.msg %></span><% } %>
        </div>

        <button type="submit">CREAR CUENTA</button>

        <a href="/login" class="enlace-vista">
            ¿YA TIENES CUENTA? INICIA SESIÓN
        </a>

    </form>

</div>

<script src="/js/validaciones.js"></script>
<script src="/js/validar-registro.js"></script>

<%- include('../partials/footer') %>