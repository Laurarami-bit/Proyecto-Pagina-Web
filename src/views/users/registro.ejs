
<%- include('../partials/head-publico', { title: 'Registro' }) %>

<link rel="stylesheet" href="/css/registro.css">

<div class="registro-container">

    <span class="icono-registro">👤</span>

    <img
        src="/images/logo.png"
        alt="Angelitos con amor"
        class="logo"
    >

    <div class="encabezado">
        <h1>REGISTRO</h1>
        <p>CREA TU CUENTA</p>
    </div>

    <form action="/usuarios/registro" method="POST">

        <div class="campo">
            <label for="nombre">👤 NOMBRE COMPLETO</label>
            <input
                type="text"
                id="nombre"
                name="nombre"
                placeholder="INGRESA TU NOMBRE"
                required
            >
        </div>

        <div class="campo">
            <label for="usuario">👤 CREA TU USUARIO</label>
            <input
                type="text"
                id="usuario"
                name="usuario"
                placeholder="CREA TU USUARIO"
                required
            >
        </div>

        <div class="campo ancho">
            <label for="correo">✉️ CORREO ELECTRÓNICO</label>
            <input
                type="email"
                id="correo"
                name="correo"
                placeholder="laura@correo.com"
                required
            >
        </div>

        <div class="campo">
            <label for="telefono">📞 TELÉFONO</label>
            <input
                type="tel"
                id="telefono"
                name="telefono"
                placeholder="INGRESA TU NÚMERO"
                required
            >
        </div>

        <div class="campo">
            <label for="fecha">📅 FECHA DE NACIMIENTO</label>
            <input
                type="date"
                id="fecha"
                name="fecha"
                required
            >
        </div>

        <div class="campo">
            <label for="contrasena">🔒 CREA TU CONTRASEÑA</label>
            <input
                type="password"
                id="contrasena"
                name="contrasena"
                placeholder="CREA TU CONTRASEÑA"
                minlength="8"
                required
            >
        </div>

        <div class="campo">
            <label for="contrasenacon">🔒 CONFIRMA TU CONTRASEÑA</label>
            <input
                type="password"
                id="contrasenacon"
                name="contrasenacon"
                placeholder="CONFIRMA TU CONTRASEÑA"
                minlength="8"
                required
            >
        </div>

        <div class="campo">
            <label for="direccion">🏠 INGRESA TU DIRECCIÓN</label>
            <input
                type="text"
                id="direccion"
                name="direccion"
                placeholder="INGRESA TU DIRECCIÓN"
                required
            >
        </div>

        <div class="campo">
            <label for="ciudad">🏙️ CIUDAD</label>
            <input
                type="text"
                id="ciudad"
                name="ciudad"
                placeholder="INGRESA TU CIUDAD"
                required
            >
        </div>

        <div class="terminos">
            <label for="terminos">
                ACEPTO LOS TÉRMINOS Y CONDICIONES
                Y POLÍTICAS DE PRIVACIDAD
            </label>

            <input
                type="checkbox"
                id="terminos"
                name="terminos"
                required
            >
        </div>

        <button type="submit">CREAR CUENTA</button>

        <a href="/login" class="enlace-vista">
            ¿YA TIENES CUENTA? INICIA SESIÓN
        </a>

    </form>

</div>

<%- include('../partials/footer') %>
