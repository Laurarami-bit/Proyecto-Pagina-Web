<%- include('../partials/head-publico', { title: 'Login' }) %>

<% const e = typeof errors !== 'undefined' ? errors : {}; %>
<% const o = typeof old !== 'undefined' ? old : {}; %>

<link rel="stylesheet" href="/css/login.css">

<div class="login-container">

    <div class="logo-box">
        <img
            src="/images/WhatsApp Image 2026-08-28 at 8.34.15 AM.jpeg"
            alt="Angelitos con amor"
        >
    </div>

    <div class="login-card">

        <h2>
            <span class="icono-titulo">👥</span>
            <br>
            INICIAR SESIÓN
        </h2>

        <form action="/usuarios/login" method="POST" novalidate>

            <div class="input-group">
                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="👤 CORREO ELECTRÓNICO"
                    autocomplete="username"
                    value="<%= o.email || '' %>"
                >
                <% if (e.email) { %><span class="error"><%= e.email.msg %></span><% } %>
            </div>

            <div class="input-group">
                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="🔒 CONTRASEÑA"
                    autocomplete="current-password"
                >
                <% if (e.password) { %><span class="error"><%= e.password.msg %></span><% } %>
            </div>

            <div class="input-group">
                <label>
                    <input type="checkbox" name="recordarme" value="on">
                    RECORDARME
                </label>
            </div>

            <button type="submit">ACCESO</button>

        </form>

        <a href="#" class="enlace-vista">
            ¿Olvidaste tu contraseña?
        </a>

        <p>
            ¿No tienes cuenta?
            <a href="/registro">Regístrate aquí</a>
        </p>

    </div>

</div>

<script src="/js/validaciones.js"></script>
<script src="/js/validar-login.js"></script>

<%- include('../partials/footer') %>
