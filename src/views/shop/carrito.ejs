
<%- include('../partials/head-publico', { title: 'carrito' }) %>
<%- include('../partials/header-publico') %>
<link rel="stylesheet" href="/css/carrito.css">
    <img class="banner" src="/images/banner1.png">

    <div class="contenedor-carrito">

        <div class="mi-carrito">

            <h2>🛒 Mi Carrito</h2>

            <div class="producto">

                <img src="/images/coche.jpg">

                <div class="info-producto">

                    <h3>Coche CITY V3</h3>

                    $500.000

                    <span class="cantidad">
                        <button onclick="cambiarCantidad(this, -1)">-</button>
                        <span class="numero">1</span>
                        <button onclick="cambiarCantidad(this, 1)">+</button>
                    </span>

                </div>

            </div>

            <div class="producto">

                <img src="/images/conjunto.jpg">

                <div class="info-producto">

                    <h3>
                        Conjunto + peluche
                        <br>
                        de apego bebé niño
                    </h3>

                    $199.990

                    <span class="cantidad">
                        <button onclick="cambiarCantidad(this, -1)">-</button>
                        <span class="numero">1</span>
                        <button onclick="cambiarCantidad(this, 1)">+</button>
                    </span>

                </div>

            </div>

        </div>

        <div class="resumen">

            <div class="linea-resumen">
                <p>Subtotal</p>
                <p>$699.990</p>
            </div>

            <div class="linea-resumen">
                <p><b>Calcular Envio</b></p>
                <p>$10.000</p>
            </div>

            <div class="linea-resumen total">
                <p>Total</p>
                <p>$709.990</p>
            </div>

            <button class="btn-comprar"
                onclick="alert('Compra realizada, gracias por confiar en Angelitos Con Amor!')">
                Finalizar Compra
            </button>

            <p style="text-align: center;">
                <b>Pago Seguro</b>
            </p>

        </div>

    </div>
<%- include('../partials/footer') %>

