
<%- include('../partials/head-publico', { title: 'detalleproducto' }) %>
<link rel="stylesheet" href="/css/detalleproducto.css">
<%- include('../partials/header-publico') %>



<img class="banner" src="/images/banner.png" alt="angelitos con amor">

<h1>Detalles del producto</h1>

<div class="producto">

    <img class="coche" src="/images/coche.jpg" alt="coche">

    <div class="texto">

        <h2>Coche CITY V3</h2>

        <h2>$500.000</h2>

        <h3>
            El coche para bebé CITY V3 acompaña cada salida desde el nacimiento
            hasta los 20 kg. Su diseño funcional combina confort, practicidad y
            soluciones pensadas para simplificar la rutina familiar.
        </h3>

        <div class="imagenes">
            <img src="/images/coche1.jpg" alt="coche1">
            <img src="/images/coche2.webp" alt="coche2">
        </div>

        <div class="colores">

            <h3>Colores disponibles</h3>

            <div class="circulos">
                <div class="circulo negro"></div>
                <div class="circulo morado"></div>
                <div class="circulo blanco"></div>
                <div class="circulo azul"></div>
            </div>

        </div>

        <div class="cantidad">
            <button>-</button>
            <input type="number" value="1" min="1">
            <button>+</button>
        </div>

        <div class="boton-carrito">
            <button>Añadir al carrito</button>
        </div>

    </div>

</div>

<%- include('../partials/footer') %>


