<%- include('../partials/header', { title }) %>

<h1><%= title %></h1>

<form method="post" action="<%= action %>" enctype="multipart/form-data">

  <p>
    <label>Nombre<br>
      <input type="text" name="name" value="<%= product.name %>" required>
    </label>
  </p>

  <p>
    <label>Descripción<br>
      <textarea name="description" rows="4" required><%= product.description %></textarea>
    </label>
  </p>

  <p>
    <label>Categoría<br>
      <select name="category" required>
        <option value="">Elige una categoría</option>
        <% categories.forEach(function (c) { %>
          <option value="<%= c %>" <%= product.category === c ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
    </label>
  </p>

  <p>
    <label>Precio<br>
      <input type="number" name="price" min="1" value="<%= product.price %>" required>
    </label>
  </p>

  <p>
    <label>Color<br>
      <select name="color">
        <option value="">Sin color</option>
        <% colors.forEach(function (c) { %>
          <option value="<%= c %>" <%= product.color === c ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
    </label>
  </p>

  <p>
    <label>Imagen<br>
      <% if (product.image) { %>
        <img src="<%= product.image %>" alt="Imagen actual"><br>
      <% } %>
      <input type="file" name="image" accept="image/*" <%= product.image ? '' : 'required' %>>
    </label>
  </p>

  <button type="submit">Guardar</button>
  <a href="/admin/productos">Cancelar</a>

</form>

<%- include('../partials/footer') %>
