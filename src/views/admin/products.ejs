 <%- include('../partials/header', { title }) %>

<link rel="stylesheet" href="/css/style.css">

<style>
    .admin-productos {
        padding: 25px;
        color: #49373a;
    }

    .admin-productos h1 {
        color: #8d4655;
        margin-bottom: 20px;
    }

    .busqueda-productos {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .busqueda-productos input {
        padding: 11px;
        border: 1px solid #e5c5ca;
        border-radius: 7px;
        width: 280px;
        max-width: 100%;
    }

    .busqueda-productos button,
    .btn-limpiar {
        padding: 10px 15px;
        border: none;
        border-radius: 7px;
        background: #8d4655;
        color: white;
        cursor: pointer;
        text-decoration: none;
    }

    .tabla-productos {
        width: 100%;
        border-collapse: collapse;
        background: white;
    }

    .tabla-productos th,
    .tabla-productos td {
        padding: 12px;
        border: 1px solid #f0dfe1;
        text-align: left;
    }

    .tabla-productos th {
        background: #fff0f1;
        color: #8d4655;
    }

    .tabla-productos img {
        width: 85px;
        height: 85px;
        object-fit: contain;
        object-position: center;
        background: #fff8f6;
        border-radius: 8px;
        display: block;
    }

    .acciones-producto {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .btn-editar,
    .btn-eliminar {
        display: inline-block;
        padding: 9px 13px;
        border-radius: 7px;
        text-decoration: none;
        font-size: 13px;
        font-weight: bold;
        cursor: pointer;
        border: none;
    }

    .btn-editar {
        background: #fbe5e8;
        color: #8d4655;
    }

    .btn-eliminar {
        background: #b94a48;
        color: white;
    }

    .btn-editar:hover {
        background: #f5d1d7;
    }

    .btn-eliminar:hover {
        background: #963936;
    }

    .form-eliminar {
        margin: 0;
    }

    @media (max-width: 650px) {
        .admin-productos {
            padding: 12px;
            overflow-x: auto;
        }

        .tabla-productos {
            min-width: 550px;
        }
    }
</style>

<%
    const listaProductos = (
        typeof products !== 'undefined'
            ? products
            : (typeof productos !== 'undefined' ? productos : [])
    );

    const busquedaActual = typeof buscar !== 'undefined' ? buscar : '';
%>

<main class="admin-productos">

    <h1>Productos</h1>

    <form class="busqueda-productos" action="/products" method="GET">
        <input
            type="text"
            name="buscar"
            placeholder="Buscar por nombre o descripción..."
            value="<%= busquedaActual %>"
        >

        <button type="submit">Buscar</button>

        <a href="/products" class="btn-limpiar">Limpiar</a>
    </form>

    <% if (listaProductos.length === 0) { %>

        <p>No se encontraron productos.</p>

    <% } else { %>

        <table class="tabla-productos">

            <thead>
                <tr>
                    <th>Imagen</th>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th>Precio</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                <% listaProductos.forEach(function (p) { %>

                    <tr>
                        <td>
                            <img src="<%= p.image || p.imagen %>" alt="<%= p.name || p.nombre %>">
                        </td>

                        <td><%= p.name || p.nombre %></td>

                        <td><%= p.category || p.categoria %></td>

                        <td>
                            $ <%= Math.round(Number(p.price ?? p.precio ?? 0)).toLocaleString('es-CO') %>
                        </td>

                        <td>
                            <div class="acciones-producto">

                                <a class="btn-editar" href="/products/<%= p.id %>/edit">
                                    Editar
                                </a>

                                <form
                                    class="form-eliminar"
                                    action="/products/<%= p.id %>?_method=DELETE"
                                    method="POST"
                                    onsubmit="return confirm('¿Seguro que deseas eliminar este producto? Esta acción no se puede deshacer.');">

                                    <button class="btn-eliminar" type="submit">
                                        Eliminar
                                    </button>

                                </form>

                            </div>
                        </td>
                    </tr>

                <% }) %>

            </tbody>

        </table>

    <% } %>

</main>

<%- include('../partials/footer') %>